    CheckAnswerRouter --> EnsembleVerifier
    AskRouter --> HybridRetriever
    AskRouter --> EnsembleVerifier

    EnsembleVerifier --> CrossEncoderVerifier
    EnsembleVerifier --> TokenProbabilityEstimator
    EnsembleVerifier --> SemanticSimilarityVerifier
    EnsembleVerifier --> ContradictionDetector

    VerifyRouter --> DatabaseManager
